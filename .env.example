API_HOST=0.0.0.0
API_PORT=8000

LLAMA_PORT=28284
# Leave blank to auto-detect Ollama's llama-server.exe from LOCALAPPDATA/Program Files.
# Set this only when auto-detect fails.
LLAMA_SERVER_EXE=

# The selected configuration profile in ThongSoModel/
MODEL_CONFIG_FILE=qwen2_5_1_5b.py

# Model path and tuning values come from the selected file in ThongSoModel.
# Uncomment only when you intentionally want to override the selected profile.
# MODEL_PATH=R:\path\to\model.gguf

# Optional tuning.
# LLAMA_THREADS=8
# LLAMA_NGL=99
# LLAMA_PARALLEL=8
# LLAMA_SLOT_CTX=5632
# LLAMA_BATCH=512
# LLAMA_UBATCH=512
